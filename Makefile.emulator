CXX := g++
CXXFLAGS := -std=c++17 -Wall -Wextra -O2 -g
SRCS := \
  emulator/emulator_main.cpp \
  emulator/cpu.cpp \
  emulator/memory.cpp \
  emulator/page.cpp \
  emulator/register_file.cpp \
  emulator/terminal.cpp \
  emulator/timer.cpp

OBJS := $(SRCS:.cpp=.o)
DEPS := $(OBJS:.o=.d)

emulator: $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $(OBJS)

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

-include $(DEPS)

clean:
	rm -f $(OBJS) $(DEPS) emulator

.PHONY: emulator clean
